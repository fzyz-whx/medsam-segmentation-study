  "model": {
   "name": "标准 2D U-Net（自实现，scripts/unet.py）",
   "architecture": "4 层下采样，基础通道 64 -> 瓶颈 1024，DoubleConv=Conv3x3-BN-ReLU x2，转置卷积上采样+跳连，1x1 输出头",
   "n_params": 31037633,
   "loss": "BCEWithLogits + 软 Dice（L = BCE + 1 - softDice，eps=1）",
   "optimizer": "Adam lr=0.0001",
   "batch_size": "16（显存探针不过自动降 8）",
   "input": "256x256（OOM 兜底降 224）",
   "max_epochs": 200,
   "epoch_budget_note": "实验方案原定 epoch<=50；实测该预算下 U-Net 严重欠收敛（Kvasir 全量 train Dice 停于 0.41，各 lr 同平台；16 张过拟合测试证明模型/损失/数据健康；根因为每图仅约 50 次更新，文献 Kvasir U-Net 每图 100+ 次更新达 Dice 0.79），为保证少样本学习曲线可回答论文核心问题，统一放宽至 200 epoch，其余超参不变（诊断记录见 logs/unet_*.log 与 STATE.md）",
   "early_stopping": "patience=5，预热 15 epoch，监控验证损失（BCE+软Dice，无阈值，平滑；阈值化 val Dice 在欠训练期噪声极大——预测概率在 0.5 附近整体翻转，曾致 patience-5 在 ~ep20 随机触发、200 epoch 预算用不满），mode=min，恢复最佳权重；阈值化 val Dice 同时记录（marker 的 val_dice_at_best）"
  },
  "protocol": {
   "splits": "splits.json 训练集（seed=42 洗牌顺序）末 1/10 固定为验证集（仅早停，任何档位不参与训练）：Kvasir-SEG 80 / ISIC2018 207；其余 90% 为训练池：720 / 1868",
   "tiers": "n=20 / 100 = 训练池前 n 张；full = 训练池全部（Kvasir-SEG n=720 / ISIC2018 n=1868）",
   "preprocess": "图像 PIL 双线性 resize 至 256x256 后 /255；mask 最近邻 resize + >=128 二值化（Phase 1 约定，与实验 A 一致）",
   "augmentation": "训练期水平/垂直翻转各 p=0.5（图像与 mask 同步）；验证/测试不增强",
   "test_protocol": "与实验 A 同一测试集（Kvasir-SEG test 200 全量；ISIC2018 test 前 500/519）与同一 Dice 惯例（两空=1.0、恰一空=0.0、macro=算术平均）；U-Net 概率图（256x256）双线性回原始分辨率后 0.5 阈值，与 MedSAM 推理协议对齐",
